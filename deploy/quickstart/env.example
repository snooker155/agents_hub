# Agents Hub, single-user Docker install: the settings file.
#
# Save this file as .env next to docker-compose.yml. It is read by the
# backend on start and edited by the Settings page, so a key entered there
# lands here too. Every variable the service knows is listed with its
# default in .env.example at the root of the repository.

# ---- A model provider (at least one; the rest can be added in Settings) ----
#DEFAULT_PROVIDER=openai
#OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...
#GOOGLE_API_KEY=...
# A local server on this machine (Ollama, LM Studio): the container reaches it
# as host.docker.internal.
#OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Optional ----
# Seed the demo workspace on first start, so every page has something to show.
#DEMO_WORKSPACE=1
# Pin a release instead of following `latest` (the tag of both images).
#AGENTS_HUB_TAG=0.8
# The port the dashboard is published on.
#WEB_PORT=8080

# ---- Phone access over HTTPS (docs/pwa.md) ----
# Caddy in front of the dashboard with a Let's Encrypt certificate for this
# domain, so the hub installs as an app on a phone and the assistant can use
# its microphone. The domain must resolve to this host, ports 80 and 443 open.
# Reachable from the internet means a login: AUTH_MODE=multi (docs/identity.md).
#COMPOSE_PROFILES=https
#HUB_DOMAIN=hub.example.com
#AUTH_MODE=multi
