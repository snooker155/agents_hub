# Agents Hub — environment template.
#
#   cp .env.example .env
#
# Then fill in the provider you actually use. Every value here is a default or
# a placeholder, so the file is safe to commit; .env itself is not.
# The backend loads .env at startup (dashboard/backend/main.py) and
# docker-compose passes it to the container.
#
# Keys are in alphabetical order; a comment describes the keys right below it.

# When set, every /api request must carry Authorization: Bearer <token>.
AGENTS_HUB_API_TOKEN=""

# Project deployments (docs/project-deployments.md): where the browser service
# reaches the hub, so the agent's browser can open a deployed app.
# AGENTS_HUB_BROWSER_HUB_URL=http://host.docker.internal:8000

# Browser service (Settings → Browser writes these): how the hub starts it
# (local process or docker container), its token, and where it is.
# AGENTS_HUB_BROWSER_MODE=local
# AGENTS_HUB_BROWSER_TOKEN=
# AGENTS_HUB_BROWSER_URL=http://127.0.0.1:3000

# Where a chat turn runs. Also switchable live on Settings → Execution.
# instances — on a replica of a service: the agent's own service when it has
#             one, else the workspace's runner ("<workspace> runner"), created
#             on first use. Pausing that runner stops chat for agents without
#             a service of their own.
# inprocess — inside the backend process, without services.
AGENTS_HUB_CHAT_EXECUTION="instances"

# Container hours in a run's cost (docs/environments.md "Sandbox size",
# docs/costs.md): USD per hour for a docker-mode run's container, per named
# sandbox size, and per vCPU-hour for a run with no size.
AGENTS_HUB_CONTAINER_HOUR_LARGE="0.20"
AGENTS_HUB_CONTAINER_HOUR_MEDIUM="0.10"
AGENTS_HUB_CONTAINER_HOUR_PER_CPU="0.05"
AGENTS_HUB_CONTAINER_HOUR_SMALL="0.05"

# Empty (default): SQLite at agents_hub.db under AGENTS_HUB_ROOT, which is
# right for one host. A postgresql:// URL puts the same schema in Postgres so
# backend replicas and workers can run on different hosts (docs/scaling.md).
# Move an existing SQLite state across with `ah db migrate --to <url>`. In the compose
# stack the bundled server is postgresql://agents_hub:agents_hub@postgres:5432/agents_hub
# started with `docker compose --profile postgres up`.
AGENTS_HUB_DATABASE_URL=""

# Postgres only: connections per process (the backend needs ~10, a run
# subprocess one or two).
# AGENTS_HUB_DB_POOL_SIZE="10"

# Delegation inside a task (docs/agents.md): how deep a chain of
# delegate_task_tool calls may go, and how long one call waits for its
# delegate before answering "still running".
AGENTS_HUB_DELEGATION_MAX_DEPTH="3"
AGENTS_HUB_DELEGATION_WAIT="900"

# Calls per minute per client address on POST /api/external/<token>/run.
AGENTS_HUB_EXTERNAL_RATE_PER_MINUTE="30"

# Project deployments: any further origin that is the hub itself.
# AGENTS_HUB_INTERNAL_ORIGINS=

# Export finished runs (with model and tool call child spans) and the hub's
# metrics to an OTLP/HTTP collector. Empty means off. The standard
# OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS work as fallbacks.
# AGENTS_HUB_OTEL_EXPORT_HEADERS=Authorization=Bearer xyz
# AGENTS_HUB_OTEL_EXPORT_URL=http://collector:4318/v1/traces
# AGENTS_HUB_OTEL_MAX_CHILD_SPANS=40
# AGENTS_HUB_OTEL_METRICS_INTERVAL=60
# AGENTS_HUB_OTEL_METRICS_URL=http://collector:4318/v1/metrics

# Project deployments: where people reach the hub (makes an app's share link
# absolute).
# AGENTS_HUB_PUBLIC_URL=https://hub.example.com

# Rate limits (docs/api-keys.md, docs/hub-as-provider.md). 0 means off.
# Requests per minute per API key or user on /api and /v1, per replica; a
# personal key may carry its own limit. Answered with 429 and Retry-After.
AGENTS_HUB_RATE_LIMIT_PER_MINUTE="0"

# Tokens per UTC day per key or user on /v1/chat/completions.
AGENTS_HUB_RATE_LIMIT_TOKENS_PER_DAY="0"

# Everything the hub writes: the SQLite database, workspace folders, run logs,
# views, downloaded local models (AGENTS_HUB_MODELS_DIR moves only those).
# Empty (default): .agents_hub inside this checkout. Point it elsewhere to run
# a second, isolated instance from the same checkout. Under docker-compose the
# checkout is mounted at /app, so a value here is a path inside the container
# (e.g. /app/.agents_hub_clean); a host path does not exist there. ah commands
# run on the host read it from the shell, not from this file.
AGENTS_HUB_ROOT=""

# Secrets at rest: the encryption key (ah secrets keygen) and the backend
# (local, or vault with AGENTS_HUB_VAULT_URL and AGENTS_HUB_VAULT_TOKEN).
AGENTS_HUB_SECRET_BACKEND="local"
AGENTS_HUB_SECRET_KEY=""

# How long a tool call held for a person in a dashboard chat turn waits for
# Approve or Deny before it is refused (docs/hooks.md "In chat"), in seconds.
AGENTS_HUB_TOOL_APPROVAL_TIMEOUT="600"

# Extra flags passed verbatim to docker run, e.g. "--memory 2g --cpus 1"
AGENT_DOCKER_EXTRA_ARGS=""

# Override the image agents run from. Empty means agents-hub/<agent_id>:latest
# when it exists, else agents-hub/base:latest.
AGENT_DOCKER_IMAGE=""
AGENT_DOCKER_NETWORK=""

# local  — agents run as subprocesses of the backend
# docker — each agent gets its own container. Needs a reachable Docker daemon:
#          natively that is yours, under docker-compose it is the socket
#          mounted into the backend service.
AGENT_EXECUTION_MODE="local"

# Stream agent tokens to the UI as they arrive.
AGENT_STREAMING="False"

# CORS origins for the dashboard. Only needed when the frontend talks to the
# backend cross-origin; nginx in the compose stack and the Vite dev server both
# proxy /api on their own origin, so usually it does not.
ALLOW_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Shell commands agents may run.
ALLOW_SHELL="python,pytest,ruff,black"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# docker-compose: the dashboard is served by nginx, which also proxies /api.
# How long nginx may cache a generated view asset; 0 turns the cache off.
# API_ASSET_CACHE_SECONDS="30"

# Audit trail: record every write request ("auto": on outside single mode).
AUDIT_REQUESTS="auto"
AUDIT_RETENTION_DAYS="365"

# Password sign-in. "false" leaves it to administrators only.
AUTH_LOCAL_PASSWORDS="true"

# Failed sign-ins per account inside the window before 429.
AUTH_LOGIN_MAX_ATTEMPTS="10"
AUTH_LOGIN_WINDOW_MINUTES="15"

# Who may use this hub (see docs/identity.md):
#   single (default) one operator, no login, no accounts, the API is open
#   token            the shared AGENTS_HUB_API_TOKEN gates every request
#   multi            named accounts with passwords, roles and workspace membership
# Leaving this unset while setting AGENTS_HUB_API_TOKEN still means token mode,
# so an existing deployment keeps behaving exactly as before.
AUTH_MODE="single"

# Corporate identity under AUTH_MODE=multi (docs/identity.md).
# Single sign-on: setting the issuer turns it on (Keycloak, Entra ID, Google).
# The groups claim is the id-token claim carrying group names; groups map to
# roles on the Accounts page. OIDC sessions are shorter (the provider re-signs
# silently).
AUTH_OIDC_CLIENT_ID=""
AUTH_OIDC_CLIENT_SECRET=""
AUTH_OIDC_GROUPS_CLAIM="groups"
AUTH_OIDC_ISSUER=""
AUTH_OIDC_PROVIDER_NAME=""
AUTH_OIDC_SCOPES="openid profile email"
AUTH_OIDC_SESSION_HOURS="8"

# The URL browsers reach the hub at, for the OIDC redirect behind a proxy.
AUTH_PUBLIC_URL=""

# SCIM 2.0 provisioning bearer token; empty turns /scim/v2 off.
AUTH_SCIM_TOKEN=""

# How long a login stays valid under AUTH_MODE=multi, in hours.
AUTH_SESSION_HOURS="336"

# docker-compose: host port of the backend. Change it if 8000 is taken; the
# dashboard follows automatically, since it talks to its own origin.
# BACKEND_PORT="8000"

# docker-compose: the backends nginx balances /api over, space separated
# host:port.
# BACKEND_SERVERS="backend:8000"

# docker-compose: the project name, which names the containers and volumes. Empty
# means the folder name, so two checkouts both called agents_hub share one
# project: `docker compose up` in one replaces the other's containers. Give
# each checkout its own name.
# COMPOSE_PROJECT_NAME="agents_hub"

# Which provider is used when no workspace or agent overrides it.
# Options: openai | anthropic | google | ollama | lmstudio
DEFAULT_PROVIDER="openai"

# GitHub Enterprise Server: https://<host>/api/v3.
# GITHUB_API_URL="https://api.github.com"

# With a GitHub App the hub issues short-lived tokens itself: an installation
# token per workspace (pull requests come from the app's bot) and, for people
# who connect their account on the Account page, a user token (pull requests
# come from them). Configured when the app id, the private key and the client
# id are set. User tokens need AGENTS_HUB_SECRET_KEY.
# Callback URL in the app settings: <public url>/api/external/github/callback
# Setup URL: <public url>/api/external/github-app/setup
# The private key is PEM text, or a path to the .pem file in the _FILE key.
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
# GITHUB_APP_PRIVATE_KEY_FILE=""
GITHUB_APP_SLUG=""

# GitHub Enterprise Server: https://<host>.
# GITHUB_URL="https://github.com"

GOOGLE_API_KEY=""
GOOGLE_MODEL=""

# Langfuse tracing, optional.
LANGFUSE_BASE_URL=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

LLM_MAX_TOKENS="15000"

# Per-request timeout in seconds. A single step on a busy local model can take
# minutes, so this is generous by design.
LLM_REQUEST_TIMEOUT="600"

LLM_TEMPERATURE="0.0"

# LM Studio (local). localhost works in a container too, see OLLAMA_BASE_URL;
# LM Studio needs its serve-on-local-network switch.
LMSTUDIO_BASE_URL="http://localhost:1234"
LMSTUDIO_MODEL=""

# Ollama (local). localhost is right here and in a container alike: a
# containerized backend rewrites it to host.docker.internal on its own. The
# server does have to listen beyond loopback for that to land, which for
# Ollama means OLLAMA_HOST=0.0.0.0.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL=""

OPENAI_API_KEY=""

# Only for OpenAI-compatible gateways; leave empty for the real API.
OPENAI_BASE_URL=""

# OPENAI_MODEL is the unified model field, whatever the provider.
OPENAI_MODEL="gpt-5"

ORCH_LOG_LEVEL="INFO"

# Embeddings for RAG. RAG_EMBEDDING_PROVIDER: sentence-transformers | openai | ollama
RAG_EMBEDDING_API_KEY=""
RAG_EMBEDDING_BASE_URL="http://localhost:11434"
RAG_EMBEDDING_MODEL="all-MiniLM-L6-v2"
RAG_EMBEDDING_PROVIDER="sentence-transformers"

# Vector store for RAG. RAG_VECTOR_DB: chroma | qdrant | pinecone | none
# Anything but none needs requirements-rag.txt installed, see WITH_RAG.
RAG_VECTOR_DB="chroma"
RAG_VECTOR_DB_API_KEY=""
RAG_VECTOR_DB_COLLECTION="agents_hub_rag"
RAG_VECTOR_DB_URL=""

# Task assignment. Options: any | manual
TASK_ASSIGNMENT_MODE="any"

# fetch_url limits and the global domain policy (same doc section). Lists are
# JSON arrays; a workspace can set its own lists in its settings.
# WEB_ALLOW_DOMAINS='["wikipedia.org"]'
# WEB_DENY_DOMAINS='[]'
# WEB_DOMAIN_POLICY_ENABLED="false"
# WEB_FETCH_MAX_CHARS="20000"
# WEB_FETCH_MAX_REDIRECTS="5"
# WEB_FETCH_TIMEOUT="20"

# docker-compose: host port of the dashboard. Change it if 8080 is taken.
# WEB_PORT="8080"

# Web search behind the web_search tool (docs/tools-and-capabilities.md, "Web
# search provider"). Set on the Settings page or here. anthropic | openai
# search through that provider's own server-side search tool on its model key
# (ANTHROPIC_API_KEY / OPENAI_API_KEY) and need no key here; brave | tavily |
# exa take WEB_SEARCH_API_KEY. Empty picks a model provider whose key is set
# (the default provider first), and with none web_search answers "not
# configured"; fetch_url needs no key. WEB_SEARCH_MODEL names the small model
# that drives a model provider's search (empty: one per provider).
# WEB_SEARCH_API_KEY=""
# WEB_SEARCH_MAX_RESULTS="5"
# WEB_SEARCH_MODEL=""
# WEB_SEARCH_PROVIDER=""

# Build the images with the RAG stack (requirements-rag.txt); without it they
# leave that stack out. docker-compose.yml passes this value to the build; a
# published image with it is the X.Y.Z-rag tag.
WITH_RAG=false
