# Agents Hub — environment template.
#
#   cp .env.example .env
#
# Then fill in the provider you actually use. Every value here is a default or
# a placeholder, so the file is safe to commit; .env itself is not.
# The backend loads .env at startup (dashboard/backend/main.py) and
# docker-compose passes it to the container.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which provider is used when no workspace or agent overrides it.
# Options: openai | anthropic | google | ollama | lmstudio
DEFAULT_PROVIDER="openai"

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
# OPENAI_MODEL is the unified model field, whatever the provider.
OPENAI_MODEL="gpt-5"
# Only for OpenAI-compatible gateways; leave empty for the real API.
OPENAI_BASE_URL=""

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# ── Google ────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=""
GOOGLE_MODEL=""

# ── Ollama (local) ────────────────────────────────────────────────────────────
# localhost is right here and in a container alike: a containerized backend
# rewrites it to host.docker.internal on its own. The server does have to
# listen beyond loopback for that to land — for Ollama, OLLAMA_HOST=0.0.0.0.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL=""

# ── LM Studio (local) ─────────────────────────────────────────────────────────
# Same rewrite applies; LM Studio needs its serve-on-local-network switch.
LMSTUDIO_BASE_URL="http://localhost:1234"
LMSTUDIO_MODEL=""

# ── LLM parameters ────────────────────────────────────────────────────────────
LLM_TEMPERATURE="0.0"
LLM_MAX_TOKENS="15000"
# Per-request timeout in seconds. A single step on a busy local model can take
# minutes, so this is generous by design.
LLM_REQUEST_TIMEOUT="600"
# Stream agent tokens to the UI as they arrive.
AGENT_STREAMING="False"

# ── Runtime behaviour ─────────────────────────────────────────────────────────
# Options: any | manual
TASK_ASSIGNMENT_MODE="any"
ORCH_LOG_LEVEL="INFO"

# ── Agent execution ───────────────────────────────────────────────────────────
# local  — agents run as subprocesses of the backend
# docker — each agent gets its own container. Needs a reachable Docker daemon:
#          natively that is yours, under docker-compose it is the socket
#          mounted into the backend service.
AGENT_EXECUTION_MODE="local"
# Override the image agents run from. Empty means agents-hub/<agent_id>:latest
# when it exists, else agents-hub/base:latest.
AGENT_DOCKER_IMAGE=""
AGENT_DOCKER_NETWORK=""
# Extra flags passed verbatim to docker run, e.g. "--memory 2g --cpus 1"
AGENT_DOCKER_EXTRA_ARGS=""

# ── Security ──────────────────────────────────────────────────────────────────
# Shell commands agents may run.
ALLOW_SHELL="python,pytest,ruff,black"
# Who may use this hub (see docs/identity.md):
#   single (default) one operator, no login, no accounts, the API is open
#   token            the shared AGENTS_HUB_API_TOKEN below gates every request
#   multi            named accounts with passwords, roles and workspace membership
# Leaving this unset while setting AGENTS_HUB_API_TOKEN still means token mode,
# so an existing deployment keeps behaving exactly as before.
AUTH_MODE="single"
# How long a login stays valid under AUTH_MODE=multi, in hours.
AUTH_SESSION_HOURS="336"
# When set, every /api request must carry Authorization: Bearer <token>.
AGENTS_HUB_API_TOKEN=""
# Corporate identity under AUTH_MODE=multi (docs/identity.md).
# Single sign-on: setting the issuer turns it on (Keycloak, Entra ID, Google).
AUTH_OIDC_ISSUER=""
AUTH_OIDC_CLIENT_ID=""
AUTH_OIDC_CLIENT_SECRET=""
AUTH_OIDC_SCOPES="openid profile email"
# The id-token claim carrying group names; groups map to roles on the Accounts page.
AUTH_OIDC_GROUPS_CLAIM="groups"
AUTH_OIDC_PROVIDER_NAME=""
# OIDC sessions are shorter (the provider re-signs silently).
AUTH_OIDC_SESSION_HOURS="8"
# Password sign-in. "false" leaves it to administrators only.
AUTH_LOCAL_PASSWORDS="true"
# Failed sign-ins per account inside the window before 429.
AUTH_LOGIN_MAX_ATTEMPTS="10"
AUTH_LOGIN_WINDOW_MINUTES="15"
# The URL browsers reach the hub at, for the OIDC redirect behind a proxy.
AUTH_PUBLIC_URL=""
# SCIM 2.0 provisioning bearer token; empty turns /scim/v2 off.
AUTH_SCIM_TOKEN=""
# Audit trail: record every write request ("auto": on outside single mode).
AUDIT_REQUESTS="auto"
AUDIT_RETENTION_DAYS="365"
# Secrets at rest: the encryption key (ah secrets keygen) and the backend
# (local, or vault with AGENTS_HUB_VAULT_URL and AGENTS_HUB_VAULT_TOKEN).
AGENTS_HUB_SECRET_KEY=""
AGENTS_HUB_SECRET_BACKEND="local"
# CORS origins for the dashboard. Only needed when the frontend talks to the
# backend cross-origin; nginx in the compose stack and the Vite dev server both
# proxy /api on their own origin, so usually it does not.
ALLOW_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ── RAG — vector store ────────────────────────────────────────────────────────
# Options: chroma | qdrant | pinecone | none
# Anything but none needs requirements-rag.txt installed (it is in the images).
RAG_VECTOR_DB="chroma"
RAG_VECTOR_DB_URL=""
RAG_VECTOR_DB_API_KEY=""
RAG_VECTOR_DB_COLLECTION="agents_hub_rag"

# ── RAG — embeddings ──────────────────────────────────────────────────────────
# Options: sentence-transformers | openai | ollama
RAG_EMBEDDING_PROVIDER="sentence-transformers"
RAG_EMBEDDING_MODEL="all-MiniLM-L6-v2"
RAG_EMBEDDING_API_KEY=""
RAG_EMBEDDING_BASE_URL="http://localhost:11434"

# ── Observability (Langfuse, optional) ────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL=""

# ── Database ──────────────────────────────────────────────────────────────────
# Empty (default): SQLite at .agents_hub/agents_hub.db, which is right for one
# host. A postgresql:// URL puts the same schema in Postgres so backend
# replicas and workers can run on different hosts (docs/scaling.md). Move an
# existing SQLite state across with `ah db migrate --to <url>`. In the compose
# stack the bundled server is postgresql://agents_hub:agents_hub@postgres:5432/agents_hub
# started with `docker compose --profile postgres up`.
AGENTS_HUB_DATABASE_URL=""
# Postgres only: connections per process (the backend needs ~10, a run
# subprocess one or two).
# AGENTS_HUB_DB_POOL_SIZE="10"

# ── docker-compose only ───────────────────────────────────────────────────────
# Host ports the stack publishes. Change them if 8000/8080 are taken; the
# dashboard follows automatically, since it talks to its own origin.
# BACKEND_PORT="8000"
# WEB_PORT="8080"
#
# The dashboard is served by nginx, which also proxies /api. These two tune it:
# the backends to balance over (space separated host:port), and how long a
# generated view asset may be cached. 0 turns the cache off.
# BACKEND_SERVERS="backend:8000"
# API_ASSET_CACHE_SECONDS="30"
