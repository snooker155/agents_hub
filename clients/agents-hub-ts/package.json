{
  "name": "@agents-hub/sdk",
  "version": "0.1.0",
  "description": "Typed client for an Agents Hub: agents, tasks, chat and the /v1 OpenAI compatible endpoints",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "openapi.schema.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen": "python3 ../../scripts/gen_ts_sdk.py"
  },
  "license": "MIT",
  "keywords": [
    "agents-hub",
    "sdk",
    "openai",
    "agents"
  ],
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
