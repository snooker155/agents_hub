    {
      "id": "factory-qa",
      "name": "Factory QA",
      "type": "factory",
      "entrypoint": "agents.qa:run_qa",
      "capabilities": ["qa", "test"]
    },
    {
      "id": "factory-ops",
      "name": "Factory DevOps",
      "type": "factory",
      "entrypoint": "agents.dev_ops:run_ops",
