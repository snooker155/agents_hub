{
  "agents": [
    {
      "id": "decomposer",
      "name": "Task Decomposer (LangChain)",
      "type": "langchain",
      "entrypoint": "orchestrator.agent:build_agent",
      "default_params": {},
      "capabilities": [
        "decompose",
        "tasks.create",
        "tasks.update",
        "tasks.sequence"
      ],
      "capacity": 1,
      "is_remote": false,
      "agent_url": null,
      "original_id": null,
      "memory_type": "shared",
      "memory_data": "fa3c9678-270c-4f06-a0fb-f4c7f8833689"
    },
    {
      "id": "swe-fs",
      "name": "SWE Agent (Filesystem)",
      "type": "langchain",
      "entrypoint": "swe_agent.agent:build_agent",
      "default_params": {},
      "capabilities": [
        "code.modify",
        "fs",
        "patch"
      ]
    },
    {
      "id": "factory-pm",
      "name": "Factory PM",
      "type": "factory",
      "entrypoint": "agents.pm:intake",
      "capabilities": ["pm", "intake"]
    },
    {
      "id": "factory-ba",
      "name": "Factory BA",
      "type": "factory",
      "entrypoint": "agents.ba:generate_brd",
      "capabilities": ["ba", "brd"]
    },
    {
      "id": "factory-sd",
      "name": "Factory SD",
      "type": "factory",
      "entrypoint": "agents.sd:generate_all",
      "capabilities": ["sd", "spec"]
    },
    {
      "id": "factory-tl",
      "name": "Factory TL",
      "type": "factory",
      "entrypoint": "agents.tl:split_tasks",
